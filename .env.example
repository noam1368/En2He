# Copy this file to ".env" (same folder as hebrew_fix.ahk) and fill in your
# own values. The real ".env" file is listed in .gitignore and must never be
# committed to Git.

# DeepL API Free key - used first (priority 1) for the Ctrl+Alt+T translation
# shortcut. Get a free key at https://www.deepl.com/pro-api (Free plan,
# 500,000 characters/month, no credit card required). Free-plan keys always
# end with ":fx", e.g. 279a2e9d-83b3-c416-7e2d-f721593e42a0:fx
DEEPL_API_KEY=

# Optional: your email address, sent to MyMemory (priority 3 fallback) to
# raise its free daily quota from 5,000 to 50,000 characters. Leave empty to
# skip this and use the lower anonymous quota.
MYMEMORY_EMAIL=
